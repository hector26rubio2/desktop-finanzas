{
  "name": "finanzas-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "main": "electron/main.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "electron-builder install-app-deps",
    "native:electron": "electron-builder install-app-deps",
    "preelectron": "pnpm native:electron",
    "preelectron:dev": "pnpm native:electron",
    "start": "ng serve",
    "build": "ng build",
    "electron": "ng build && electron .",
    "electron:dev": "concurrently -k -n angular,electron -c cyan,green \"ng serve\" \"wait-on tcp:4200 && cross-env NODE_ENV=development electron . --dev\"",
    "pack": "ng build && electron-builder --dir",
    "dist": "ng build && electron-builder",
    "dist:win": "ng build && electron-builder --win",
    "dist:mac": "ng build && electron-builder --mac",
    "dist:linux": "ng build && electron-builder --linux",
    "release": "ng build && electron-builder --publish always",
    "test": "vitest run",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test electron/security.audit.test.js electron/local-data/database.test.js electron/local-data/auth-store.test.js electron/local-data/release.e2e.test.js",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts,.html",
    "lint:fix": "eslint src/ --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "dependencies": {
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/platform-browser-dynamic": "^21.2.20",
    "@angular/router": "^21.2.20",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "engines": {
    "node": ">=20.19 <25"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "angular-eslint": "^21.4.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-builder",
      "better-sqlite3",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "uuid": "^14.0.0",
      "js-yaml": "^4.2.0"
    }
  }
}
