{
  "name": "finanzas-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "main": "electron/main.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "ng serve",
    "build": "ng build",
    "electron": "ng build && electron .",
    "electron:dev": "concurrently -k -n angular,electron -c cyan,green \"ng serve\" \"wait-on tcp:4200 && cross-env NODE_ENV=development electron . --dev\"",
    "pack": "ng build && electron-builder --dir",
    "dist": "ng build && electron-builder",
    "dist:win": "ng build && electron-builder --win",
    "dist:mac": "ng build && electron-builder --mac",
    "dist:linux": "ng build && electron-builder --linux",
    "release": "ng build && electron-builder --publish always",
    "lint": "eslint src/ --ext .ts,.html",
    "lint:fix": "eslint src/ --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/material": "^21.2.11",
    "@angular/platform-browser": "^21.2.13",
    "@angular/platform-browser-dynamic": "^21.2.13",
    "@angular/router": "^21.2.13",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.11",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@tailwindcss/postcss": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "angular-eslint": "^21.4.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9",
    "wait-on": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-builder",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "uuid": "^14.0.0"
    }
  }
}
