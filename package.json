{
  "name": "finanzas-desktop",
  "version": "1.0.0",
  "description": "Aplicación de escritorio local y cifrada para gestionar finanzas personales.",
  "author": "Hector Rubio",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hector26rubio2/desktop-finanzas.git"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "native:electron": "electron-builder install-app-deps",
    "preelectron": "pnpm native:electron",
    "preelectron:dev": "pnpm native:electron",
    "start": "ng serve",
    "build": "ng build",
    "electron": "ng build && electron .",
    "electron:dev": "concurrently -k -n angular,electron -c cyan,green \"ng serve\" \"wait-on tcp:4200 && cross-env NODE_ENV=development electron . --dev\"",
    "package:dir": "ng build && electron-builder --dir",
    "dist": "ng build && electron-builder",
    "dist:win": "ng build && electron-builder --win --publish never",
    "dist:mac": "ng build && electron-builder --mac --publish never",
    "dist:linux": "ng build && electron-builder --linux --publish never",
    "release:win": "node scripts/verify-release-env.mjs win && ng build && electron-builder --win --publish never -c.forceCodeSigning=true",
    "release:mac": "node scripts/verify-release-env.mjs mac && ng build && electron-builder --mac --publish never -c.forceCodeSigning=true",
    "release:linux": "node scripts/verify-release-env.mjs linux && ng build && electron-builder --linux --publish never",
    "release": "node scripts/verify-release-env.mjs publish && ng build && electron-builder --publish always -c.forceCodeSigning=true",
    "test": "ng test --watch=false",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test electron/security.audit.test.js electron/services/ipc-security.test.js electron/local-data/database.test.js electron/local-data/auth-store.test.js electron/local-data/release.e2e.test.js",
    "test:ui": "pnpm build && node scripts/e2e-smoke.mjs",
    "test:packaged:win": "cross-env FINANZAS_EXECUTABLE=release/win-unpacked/Finanzas.exe node scripts/e2e-smoke.mjs",
    "test:watch": "ng test --watch",
    "lint": "eslint src/ electron/ scripts/ eslint.config.js --ext .ts,.html,.js,.mjs",
    "lint:fix": "eslint src/ electron/ scripts/ eslint.config.js --ext .ts,.html,.js,.mjs --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"electron/**/*.js\" \"scripts/**/*.mjs\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"electron/**/*.js\" \"scripts/**/*.mjs\" \"eslint.config.js\""
  },
  "dependencies": {
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@12.11.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9"
  },
  "engines": {
    "node": ">=20.19 <25"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "angular-eslint": "^22.1.0",
    "axe-core": "4.13.0",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "42.10.1",
    "electron-builder": "26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5",
    "zone.js": "~0.16.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-builder",
      "better-sqlite3",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "@hono/node-server": "1.19.15",
      "axios": "1.18.0",
      "brace-expansion@1.1.14": "1.1.18",
      "brace-expansion@2.1.1": "2.1.4",
      "brace-expansion@5.0.6": "5.0.9",
      "esbuild@0.18.20": "0.25.12",
      "fast-uri": "3.1.5",
      "form-data": "4.0.6",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "uuid": "^14.0.0",
      "js-yaml": "^4.3.1",
      "tar": "7.5.21",
      "tmp": "0.2.7",
      "undici@6.27.0": "6.28.0",
      "undici@7.28.0": "7.29.0"
    }
  }
}
